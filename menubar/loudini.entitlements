<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Under the hardened runtime (release/notarized builds), capturing system
	     audio through the Core Audio process tap needs this. Harmless on the
	     menu-bar binary, required on the daemon. Verify at first notarization;
	     add more only if the runtime or notarytool flags something. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
