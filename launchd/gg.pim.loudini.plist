<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: scripts/install-daemon.sh replaces __HELPER__ and __HOME__ with
     absolute paths (launchd does not expand ~) and installs the result into
     ~/Library/LaunchAgents/. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>gg.pim.loudini</string>
	<key>ProgramArguments</key>
	<array>
		<string>__HELPER__</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<!-- Interactive keeps App Nap / background QoS from throttling the audio path. -->
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>StandardOutPath</key>
	<string>__HOME__/.config/loudini/daemon.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/.config/loudini/daemon.log</string>
</dict>
</plist>
