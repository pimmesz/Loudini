<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: scripts/install-daemon.sh replaces __HELPER__ and __HOME__ with
     absolute paths (launchd does not expand ~) and installs the result into
     ~/Library/LaunchAgents/. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>gg.pim.loudini</string>
	<key>ProgramArguments</key>
	<array>
		<string>__HELPER__</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<!-- Unconditional restart. When the menu-bar app's bundled daemon already holds
	     daemon.lock, this agent's daemon loses the flock, exit(0)s, and is relaunched
	     ~every 10s (log spam) until it wins the lock. Do NOT "fix" that with
	     KeepAlive={SuccessfulExit=false}: the same relaunch is what lets the agent
	     TAKE OVER once the app quits and frees the lock (the app terminates its
	     daemon on quit), so gating on failure leaves NO daemon running afterward.
	     Removing both the spam and the dormancy needs the loser to block on the lock
	     instead of exit — a daemon change, deferred. -->
	<key>KeepAlive</key>
	<true/>
	<!-- Interactive keeps App Nap / background QoS from throttling the audio path. -->
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>StandardOutPath</key>
	<string>__HOME__/.config/loudini/daemon.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/.config/loudini/daemon.log</string>
</dict>
</plist>
