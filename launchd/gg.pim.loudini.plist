<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: scripts/install-daemon.sh replaces __HELPER__ and __HOME__ with
     absolute paths (launchd does not expand ~) and installs the result into
     ~/Library/LaunchAgents/. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>gg.pim.loudini</string>
	<key>ProgramArguments</key>
	<array>
		<string>__HELPER__</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<!-- Unconditional restart, for a daemon that crashes. When the menu-bar app's
	     daemon already holds daemon.lock, this agent's daemon waits on the lock
	     (no tty, so it does not exit) and takes over once the app quits and frees
	     it. Do NOT switch to KeepAlive={SuccessfulExit=false}: see DECISIONS.md. -->
	<key>KeepAlive</key>
	<true/>
	<!-- Interactive keeps App Nap / background QoS from throttling the audio path. -->
	<key>ProcessType</key>
	<string>Interactive</string>
	<!-- 077: daemon.log and the config files it creates stay readable by this user only. -->
	<key>Umask</key>
	<integer>63</integer>
	<key>StandardOutPath</key>
	<string>__HOME__/.config/loudini/daemon.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/.config/loudini/daemon.log</string>
</dict>
</plist>
